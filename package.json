{
  "name": "dishdeals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:map && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"scripts/**\"",
    "agents": "node scripts/agent-workflow.mjs",
    "test:workflow": "node --test scripts/agent-workflow.test.mjs",
    "setup:map": "npm --prefix map-component ci --cache /tmp/dishdeals-npm-cache --prefer-offline --no-audit --no-fund",
    "build:map": "npm run setup:map && npm --prefix map-component run build",
    "check": "npm run build:map && npm run typecheck && npm run lint && npm run test && npm run test:workflow && npm run build"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/geospatial": "0.2.1",
    "@convex-dev/workflow": "^0.4.8",
    "@google/genai": "^2.27.0",
    "@restaurant-deals/map": "file:./map-component",
    "@solana-program/memo": "^0.11.2",
    "@solana-program/system": "^0.12.2",
    "@solana-program/token": "^0.12.0",
    "@solana-program/token-2022": "^0.9.0",
    "@solana/keys": "^6.10.0",
    "@solana/kit": "^6.10.0",
    "@solana/kit-plugin-instruction-plan": "^0.10.0",
    "@solana/kit-plugin-rpc": "^0.11.1",
    "@solana/kit-plugin-signer": "^0.10.0",
    "@solana/pay": "^1.0.26",
    "@solana/rpc-subscriptions-api": "^6.10.0",
    "@solana/rpc-subscriptions-spec": "^6.10.0",
    "convex": "^1.46.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.60",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.0.13",
    "vitest": "^5.0.3"
  }
}
