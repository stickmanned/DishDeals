+  const candidates = await findRestaurant({ ...deal, locationHint: "Broadway + Ash" }, inputSchema.parse(input), { apiKey: "test", fetcher });
+  expect(new URL(String(fetcher.mock.calls[1][0])).searchParams.get("text")).toBe("Vancouver, British Columbia");
+  expect(candidates[0].placeId).toBe("verified");
