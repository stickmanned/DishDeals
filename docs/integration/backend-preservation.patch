+      { place_id: "no-coordinates", name: "Example Ramen", country_code: "ca", formatted: "Richmond", categories: ["catering.restaurant"] },
+    ]));
+  expect(await findRestaurant(deal, inputSchema.parse(input), { apiKey: "test", fetcher })).toEqual([]);
