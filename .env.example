# Public, non-secret web configuration (Next.js)
NEXT_PUBLIC_CONVEX_URL=
# The deployment's HTTP origin (https://<name>.convex.site). Set explicitly; never guess a regional host.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Convex deployment environment (set with `npx convex env set`, not in this file):
#   REEL_WEB_ORIGIN               exact https origin of the website, e.g. https://app.example.com (http only for an explicit localhost development origin)
#   REEL_MEDIA_USAGE_AUTHORIZED   "true" only after Gemini video analysis of user-supplied recordings is authorized
#   GEMINI_API_KEY, GEMINI_REEL_MODEL   server-only model credentials; the model is always configured explicitly
#   REEL_PROVIDER_USAGE_AUTHORIZED, SCRAPECREATORS_API_KEY   legacy resolver gate; leave unset
#   IMAGE_PROVIDER_USAGE_AUTHORIZED   "true" only after Gemini analysis of screenshots/flyers is authorized (separate from the reel gates)
#   GEMINI_IMAGE_MODEL            required for image extraction; always explicit (no implicit default)
#   GEMINI_IMAGE_FALLBACK_MODEL   optional; if unset the primary model is simply tried again
#   (image upload also uses REEL_WEB_ORIGIN as the allowed website origin; CONVEX_SITE_URL is platform-provided)
#   GEOCODE_USAGE_AUTHORIZED      "true" only after Nominatim use for the explicit Find-location button is authorized
#   GEOCODE_USER_AGENT            required when authorized: a genuine identifying User-Agent with real contact info (no default)
#   GEOCODE_ENDPOINT              optional https search endpoint (default: the plan's Nominatim /search); localhost http only
#
# Preserved published workflow (teammate backend; separate from the canonical reel/image/geocode gates). Names only:
#   WORKFLOW_PROVIDER_USAGE_AUTHORIZED   "true" only after live Gemini/Geoapify spend for the legacy workflow is authorized (default off; no other gate enables it)
#   GEMINI_API_KEY, GEOAPIFY_API_KEY     server-only provider credentials
#   GEMINI_MODEL                         required explicit primary model for source extraction; no implicit default
#   GEMINI_FALLBACK_MODEL                optional; if unset the primary model is simply tried again
#   GEMINI_SEARCH_MODEL, GEMINI_WEB_SEARCH_MODEL, GEMINI_COMPARISON_MODEL   each explicit; a feature whose model is unset makes no provider request
#   WORKFLOW_API_TOKEN                   32+ characters; enables the /v1 server-integration routes (they stay off while unset)
#   (typed env: declared in convex/convex.config.ts and read with `env` from ./_generated/server)
