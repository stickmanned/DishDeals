{
  "name": "DishDeals",
  "short_name": "DishDeals",
  "description": "Food deals around Vancouver, shared by the people who find them.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F8F4EF",
  "theme_color": "#F22E4F",
  "icons": [
    { "src": "/share-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/share-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "image", "accept": ["image/jpeg", "image/png", "image/webp"] }]
    }
  }
}
