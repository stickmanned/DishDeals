# Local CLI only. Convex cloud actions use Dashboard > Settings > Environment Variables.
GEMINI_API_KEY=
GEOAPIFY_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional separate model for search intent and recommendation planning.
GEMINI_SEARCH_MODEL=
# Optional separate model for value and taste comparison.
GEMINI_COMPARISON_MODEL=
# Optional stronger extraction model; used only for invalid/truncated model output.
GEMINI_FALLBACK_MODEL=
# Server-to-server HTTP integration only; never place this in frontend code.
WORKFLOW_API_TOKEN=
